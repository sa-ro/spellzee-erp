# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/install-state.gz

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# NestJS
*.js.map

# Environment — never commit secrets
.env
.env.*
!.env.example

# Prisma — generated client and any local database file.
# Migrations themselves ARE committed: they carry the hand-written invariants.
prisma/generated/
prisma/*.db
prisma/*.db-journal
prisma/dev.db*

# Testing
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
.playwright/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Claude Code — local overrides only.
# .claude/{agents,commands,skills} ARE committed: they are project configuration.
.claude/settings.local.json

# Docker / local infra volumes
docker-data/
pgdata/

# Temporary
tmp/
temp/
*.tmp
.cache/

# Emitted declarations and JS next to their sources. `outDir` keeps normal builds
# in dist/, but tsc -b --clean and a mis-set rootDir can drop them beside the .ts
# file — committing a stale .d.ts is worse than not building at all, because it
# type-checks green against yesterday's shape.
packages/**/*.js
packages/**/*.d.ts
packages/**/*.js.map
packages/**/*.d.ts.map
!packages/**/*.config.js
