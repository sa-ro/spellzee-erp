# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/install-state.gz

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# NestJS
*.js.map

# Environment — never commit secrets
.env
.env.*
!.env.example

# Prisma — generated client and any local database file.
# Migrations themselves ARE committed: they carry the hand-written invariants.
prisma/generated/
prisma/*.db
prisma/*.db-journal
prisma/dev.db*

# Testing
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
.playwright/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Claude Code — local overrides only.
# .claude/{agents,commands,skills} ARE committed: they are project configuration.
.claude/settings.local.json

# Docker / local infra volumes
docker-data/
pgdata/

# Temporary
tmp/
temp/
*.tmp
.cache/
