{
  "$comment": [
    "NestJS on Node. NodeNext resolution, no DOM.",
    "Add \"types\": [\"node\"] when @types/node arrives with NestJS — omitted now so this",
    "compiles against an empty tree."
  ],
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
