    "live":          { "color": null, "icon": null, "covers": ["live"] },
    "positive":      { "color": null, "icon": null, "covers": ["completed", "attended", "compensation_completed"] },
    "partial":       { "color": null, "icon": null, "covers": ["partial", "late"] },
    "student-fault": { "color": null, "icon": null, "covers": ["absent", "late_cancellation", "student_side_technical"] },
    "our-fault":     { "color": null, "icon": null, "covers": ["teacher_absent", "teacher_side_technical", "spellzee_cancellation"] },
    "protected":     { "color": null, "icon": null, "covers": ["parent_advance_cancellation", "rescheduled"] },
    "owed":          { "color": null, "icon": null, "covers": ["compensation_required"] },
    "void":          { "color": null, "icon": null, "covers": ["cancelled_no_show"] }
  },

