# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Database ---------------------------------------------------------------
# Local development. Note the port: PostgreSQL 17 runs on 5433 on this machine
# because a PostgreSQL 16 instance already occupies 5432.
DATABASE_URL="postgresql://spellzee:spellzee_dev@localhost:5433/spellzee_dev?schema=public"

# Constraint and integration tests run against a real database, never a mock.
# This one is wiped freely — keep it separate from the dev database.
TEST_DATABASE_URL="postgresql://spellzee:spellzee_dev@localhost:5433/spellzee_test?schema=public"

# --- Redis (BullMQ) ---------------------------------------------------------
# Not installed yet. Redis holds only derived, ephemeral or externally-owned
# state — it is allowed to lose everything at any moment.
REDIS_URL="redis://localhost:6379"

# --- Application ------------------------------------------------------------
NODE_ENV="development"
PORT=3000
LOG_LEVEL="debug"

# --- Merithub (LMS / live classroom) ----------------------------------------
# No idempotency keys, no webhook signatures, no retry guarantee upstream —
# which is why every call goes through the outbox and inbound events are
# deduplicated. Never call their DELETE.
MERITHUB_BASE_URL=""
MERITHUB_CLIENT_ID=""
MERITHUB_CLIENT_SECRET=""
MERITHUB_WEBHOOK_SECRET=""

# --- Auth -------------------------------------------------------------------
# Provider undecided. Buy, don't build: staff SSO now, a separate parent
# credential path in phase 2. Session and RBAC state stays ours; the identity
# provider does not own authorization.
AUTH_ISSUER_URL=""
AUTH_CLIENT_ID=""
AUTH_CLIENT_SECRET=""

# --- Object storage ---------------------------------------------------------
# Worksheets, materials, recordings. Never files in the database, never on the
# container's disk. Provider follows the cloud decision.
STORAGE_BUCKET=""
STORAGE_REGION=""

# --- Observability ----------------------------------------------------------
# Error tracking from commit one. The stalled-outbox and stalled-provisioning
# queues are product surfaces, not just monitoring.
SENTRY_DSN=""
